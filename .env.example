# ============================================================
# JobPilot 环境配置模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，不会进仓库。
# ============================================================

# ---------- 大模型（OpenAI 兼容协议） ----------
# DeepSeek 官方端点，也兼容任何 OpenAI 协议的服务（如本地 vLLM / Ollama）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------- Agent 行为 ----------
# 单轮对话内最多允许的工具调用步数（防止死循环烧 token）
AGENT_MAX_STEPS=12
# 连续多少次工具调用完全相同则判定为循环并中止
AGENT_LOOP_GUARD=3

# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- 存储（P2 起使用） ----------
DATABASE_URL=sqlite+aiosqlite:///./data/jobpilot.db
REDIS_URL=redis://127.0.0.1:6379/0
# 无 Redis 时用内存假实现，方便本地开发
REDIS_FAKE=true

# ---------- 向量检索 / RAG ----------
# 检索模式：dense（纯向量）| sparse（纯 BM25）| hybrid（RRF 融合）
# 默认 hybrid 由消融实验给出：召回受限时混合检索优于纯向量，
# 而生产环境的 recall_k 远小于语料规模，恰好落在混合检索有效的区间。
RAG_MODE=hybrid

# 重排器：none | lexical | llm
# lexical 是唯一稳定带来收益且零成本的选项（MRR +0.053）。
# llm 效果显著更好（MRR +0.414）但每次查询多一次 LLM 调用（约 2361 tokens/查询），
# 在 Agent 循环里会成倍放大，因此默认关闭。
RAG_RERANKER=lexical

# 切分参数（min_chunk_size=120 由消融实验确定：MRR@5 相对提升 26%，
# 而过大的块会稀释语义导致指标回落）
RAG_STRATEGY=section
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_MIN_CHUNK_SIZE=120

# 检索参数
RAG_TOP_K=4
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=3000

# 相关性闸门（余弦相似度下限，0 = 关闭）。
# RRF/BM25 只有相对排名，没有"都不相关"的概念，不设闸门时混合检索
# 永远会凑满 k 条噪声。但合理阈值高度依赖语料，设错会静默丢掉正确结果，
# 所以默认关闭 —— 要开启请先在评测集上标定：
#   python scripts/eval_rag.py --run --mode hybrid --rerank lexical
RAG_MIN_SCORE=0.0

# ---------- 记忆 ----------
# 默认关闭。记忆会增加每轮的记忆装配与召回开销，**它的价值应该被度量而不是
# 被假设** —— 与检索消融实验同样的方法论。开启方式：MEMORY_ENABLED=true
# 或用 CLI 的 --memory 开关临时启用。
MEMORY_ENABLED=false

# 短期记忆：超出 max_turns 轮就压缩，但保留最近 keep_recent 轮原文。
# 摘要是有损的，越近的上下文越需要保真，所以 keep_recent 不能太小。
MEMORY_MAX_TURNS=8
MEMORY_KEEP_RECENT=6
# 开启后每"超出窗口一次"多一次 LLM 调用（不是每轮），换来旧信息不丢失。
# 关掉则退化为截断：便宜，但会突然失忆（会记 WARNING 日志，不静默）。
MEMORY_ENABLE_SUMMARY=true
MEMORY_MAX_SUMMARY_CHARS=1200

# 长期记忆：超过上限后淘汰最早的。生产应改为按访问时间淘汰，
# 或让模型判断重要性（前者需记录访问，后者需额外调用）。
MEMORY_MAX_FACTS=200
MEMORY_FACTS_PATH=data/memory/facts.json

# ---------- 会话存储 ----------
# auto | memory | fake | redis
#
#   memory  单元测试、单进程 demo（不可跨进程共享）
#   fake    本地开发：走**真实 Redis 代码路径**但不需要 Docker（无跨进程共享）
#   redis   生产、多副本部署（需要真 Redis）
#   auto    默认：连得上真 Redis 就用，否则降级到内存并打 WARNING
#
# 注意：`auto` 的降级会打醒目日志。静默降级会让人误以为多进程共享已生效，
# 实际表现是"用户偶尔丢历史"这种极难定位的间歇性故障。
# 当前实际使用的后端可在 /healthz 的 session_backend 字段查看。
SESSION_BACKEND=auto
SESSION_TTL_SECONDS=604800
SESSION_MAX_SESSIONS=500

# ---------- 异步任务队列 ----------
# auto | memory | redis
#
# 存在的理由很具体：知识库重建索引要读全部文档 → 切分 → 拟合 TF-IDF →
# 建 BM25 倒排表。当前语料下几百毫秒，涨到几千块时就是几秒到几十秒。
# 而它是同步 CPU 密集操作，会阻塞整个事件循环 —— 期间所有 HTTP 请求
# （包括别人的对话流式响应）全部停摆。拆出去之后 API 立刻返回 task_id，
# 前端轮询进度，事件循环不受影响。
#
# ⚠ 投递语义的差别：
#   memory  任务与进程同生共死，不存在投递丢失
#   redis   **至多一次** —— worker 崩溃会让任务永久消失（BRPOP 取走即删除）
#           升级成至少一次需要 Redis Streams + 消费者组（XACK/XAUTOCLAIM），
#           属于 P4 的范围。详见 app/tasks/redis_queue.py 的模块文档。
TASK_BACKEND=auto

# 处理器会把 CPU 密集的活丢线程池，多开 worker 只会让线程数相乘，
# 收益有限而上下文切换成本上升，所以默认 1。
TASK_WORKER_COUNT=1
TASK_MAX_TASKS=200
TASK_TTL_SECONDS=86400

# 是否在 API 进程内启动 worker。
#   true （默认，单体）     worker 跟随 API 进程，零配置可用
#   false（拆分部署）       API 只投递，任务由独立 worker 进程消费
#
# ⚠ 设成 false 时 **必须同时** 用 TASK_BACKEND=redis：
#   进程内队列不跨进程，独立 worker 收不到 API 投递的任务。
#   这个组合会让任务永远停在 pending 而服务完全健康，
#   因此 build_task_queue 会直接拒绝启动（而不是静默失效）。
TASK_RUN_WORKERS_IN_API=true

# ---------- 微服务拆分（P4） ----------
# 独立的 RAG 检索服务地址。空 = 在 agent 进程内直接检索（单体，默认）。
#
# 拆分动机是具体的，不是架构洁癖：
#   1. RAG 是 CPU 密集（拟合 TF-IDF、建 BM25 倒排、重建索引），
#      agent 是 IO 密集（大部分时间在等模型）。同进程时重建索引会抢走
#      agent 的 CPU —— 表现为"别人正在对话时页面卡住"。
#   2. 两者伸缩比不同：对话高峰要更多 agent 副本，
#      索引/批量检索高峰要更多 RAG 副本。绑在一起只能一起扩。
#   3. 故障隔离：RAG 崩了不该让整个对话服务不可用（agent 会降级）。
#
# 启动独立 RAG 服务：
#   .\.venv\Scripts\python.exe -m uvicorn app.rag_service.main:app \
#       --port 8001 --app-dir services/api
# 然后设置 RAG_SERVICE_URL=http://127.0.0.1:8001
#
# 当前实际拓扑可在 /healthz 的 rag_backend 字段查看（local | remote）。
# 跨进程验证：python scripts/verify_split.py
RAG_SERVICE_URL=

# 调用远程 RAG 服务的超时（秒）。
# 必须显式设置：httpx 默认不限时等待，服务卡死时调用方会无限期挂住。
# 取值要比正常检索耗时高一个数量级（正常几十毫秒 → 给 15 秒），
# 否则会把偶发慢查询误判为故障。
RAG_SERVICE_TIMEOUT=15
