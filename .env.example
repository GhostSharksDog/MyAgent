# ============================================================
# JobPilot 环境配置模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，不会进仓库。
# ============================================================

# ---------- 大模型（OpenAI 兼容协议） ----------
# DeepSeek 官方端点，也兼容任何 OpenAI 协议的服务（如本地 vLLM / Ollama）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------- Agent 行为 ----------
# 单轮对话内最多允许的工具调用步数（防止死循环烧 token）
AGENT_MAX_STEPS=12
# 连续多少次工具调用完全相同则判定为循环并中止
AGENT_LOOP_GUARD=3

# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- 存储（P2 起使用） ----------
DATABASE_URL=sqlite+aiosqlite:///./data/jobpilot.db
REDIS_URL=redis://127.0.0.1:6379/0
# 无 Redis 时用内存假实现，方便本地开发
REDIS_FAKE=true

# ---------- 向量检索（P2 起使用） ----------
# tfidf  = 零依赖基线，先用 sklearn 建立可对比的检索基线
# local  = 本地 embedding 模型
# api    = 调用远端 embedding 接口
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
